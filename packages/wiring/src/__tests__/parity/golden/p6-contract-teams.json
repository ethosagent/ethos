  "teams.memoryRead": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "key": {
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string"
        },
        "team": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "team",
        "key"
      ],
      "type": "object"
    },
    "meta": {},
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "content": {
          "type": "string"
        },
        "key": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "content"
      ],
      "type": "object"
    },
    "route": {}
  },
  "teams.memoryWrite": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "action": {
          "enum": [
            "add",
            "replace",
            "delete"
          ],
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "key": {
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string"
        },
        "team": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "team",
        "key",
        "action"
      ],
      "type": "object"
    },
    "meta": {},
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "ok": {
          "const": true,
          "type": "boolean"
        }
      },
      "required": [
        "ok"
      ],
      "type": "object"
    },
    "route": {}
  }
