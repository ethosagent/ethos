{
  "debug.chat": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "clientId": {
          "type": "string"
        },
        "mainSessionId": {
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "mainSessionId",
        "message"
      ],
      "type": "object"
    },
    "meta": {},
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "response": {
          "type": "string"
        },
        "sessionId": {
          "type": "string"
        },
        "turnId": {
          "type": "string"
        }
      },
      "required": [
        "sessionId",
        "turnId",
        "response"
      ],
      "type": "object"
    },
    "route": {}
  }
}
