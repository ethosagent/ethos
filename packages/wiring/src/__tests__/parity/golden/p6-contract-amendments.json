                "schemaVersion",
                "id",
                "personalityId",
                "target",
                "ops",
                "opsHash",
                "baseHash",
                "rationale",
                "evidence",
                "provenance",
                "preCheck",
                "status",
                "history",
                "createdAt",
                "updatedAt"
