                    },
                    "initiator": {
                      "enum": [
                        "user",
                        "system"
                      ],
                      "type": "string"
                    },
                    "origin": {
                      "type": "string"
                    },
                    "platform": {
                      "type": "string"
                    },
                    "roomAudience": {
                      "enum": [
                        "private",
                        "shared"
                      ],
                      "type": "string"
                    },
                    "sessionId": {
                      "type": "string"
                    },
                    "sessionKey": {
                      "type": "string"
                    },
                    "traceId": {
                      "type": "string"
                    },
                    "turn": {
                      "type": "number"
                    }
