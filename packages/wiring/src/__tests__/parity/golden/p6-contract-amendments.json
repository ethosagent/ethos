                  "required": [
                    "sessionId",
                    "sessionKey",
                    "platform",
                    "initiator",
                    "roomAudience",
                    "executionPosture",
                    "holdsShellTool"
                  ],
                  "type": "object"
                },
                "rationale": {
                  "type": "string"
                },
                "schemaVersion": {
                  "const": 1,
                  "type": "number"
                },
                "status": {
                  "enum": [
                    "pending",
                    "applied",
                    "declined",
                    "auto_rejected",
                    "stale",
                    "rolled_back"
                  ],
                  "type": "string"
                },
                "target": {
                  "enum": [
                    "toolset",
                    "identity"
                  ],
                  "type": "string"
                },
                "updatedAt": {
                  "type": "string"
