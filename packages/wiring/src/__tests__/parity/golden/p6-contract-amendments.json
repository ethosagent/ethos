              "type": "array"
            }
          },
          "required": [
            "record",
            "file",
            "personality",
            "liveHash",
            "stale",
            "interruptedApply",
            "expectedAfterHash",
            "textDiff",
            "permissionDiff",
            "notCompared",
            "flags"
          ],
          "type": "object"
        }
      },
      "required": [
        "review"
      ],
      "type": "object"
    },
