{
  "mesh.list": {
    "input": null,
    "meta": {},
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "agents": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "activeSessions": {
                "maximum": 9007199254740991,
