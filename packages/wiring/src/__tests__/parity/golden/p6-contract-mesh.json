                "type": "integer"
              },
              "agentId": {
                "type": "string"
              },
              "capabilities": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "lastSeenAt": {
                "type": "string"
              }
            },
            "required": [
              "agentId",
              "capabilities",
              "activeSessions",
              "lastSeenAt"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "agents"
      ],
      "type": "object"
    },
    "route": {}
  },
  "mesh.routeTest": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "capability": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "capability"
      ],
      "type": "object"
