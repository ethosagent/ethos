  "plugins.list": {
    "input": null,
    "meta": {},
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "mcpServers": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "auth_status": {
                "anyOf": [
                  {
                    "enum": [
                      "none",
                      "authorized",
                      "expired",
                      "missing",
                      "pending"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "command": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "created_via": {
                "anyOf": [
                  {
                    "enum": [
                      "cli",
                      "ui"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "deprecated": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "mcpResultLimitChars": {
                "anyOf": [
                  {
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "name": {
                "type": "string"
              },
              "transport": {
                "enum": [
                  "stdio",
                  "sse",
                  "streamable-http"
                ],
                "type": "string"
              },
              "url": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "name",
              "transport",
              "command",
              "url",
              "auth_status",
              "created_via",
              "mcpResultLimitChars",
              "deprecated"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "plugins": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "description": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "error": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "hasHomePanel": {
                "type": "boolean"
              },
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "pluginContractMajor": {
                "anyOf": [
                  {
                    "maximum": 9007199254740991,
                    "minimum": -9007199254740991,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "scanFindings": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "excerpt": {
                      "type": "string"
                    },
                    "file": {
                      "type": "string"
                    },
                    "line": {
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    },
                    "rule": {
                      "type": "string"
                    },
                    "severity": {
                      "enum": [
                        "red",
                        "yellow"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "severity",
                    "rule",
                    "message"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "source": {
                "enum": [
                  "user",
                  "project",
                  "npm"
                ],
                "type": "string"
              },
              "status": {
                "anyOf": [
                  {
                    "enum": [
                      "loaded",
                      "failed"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "trustTier": {
                "anyOf": [
                  {
                    "enum": [
                      "builtin",
                      "trusted-repo",
                      "community",
                      "untrusted"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "version",
              "description",
              "source",
              "path",
              "pluginContractMajor",
              "status",
              "error"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "plugins",
        "mcpServers"
      ],
      "type": "object"
    },
    "route": {}
  },
  "plugins.listCredentialKeys": {
    "input": {
