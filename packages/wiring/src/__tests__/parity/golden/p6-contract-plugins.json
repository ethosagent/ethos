                    "type": "null"
                  }
                ]
              },
              "type": {
                "enum": [
                  "secret",
                  "text"
                ],
                "type": "string"
              },
              "updatedAt": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "key",
              "label",
              "type",
              "description",
              "refreshHint",
              "required",
              "isSet",
              "updatedAt"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "keys"
      ],
      "type": "object"
    },
    "route": {}
