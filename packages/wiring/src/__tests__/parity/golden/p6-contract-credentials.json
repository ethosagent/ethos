{
  "credentials.delete": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "name": {
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "meta": {},
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "ok": {
          "const": true,
          "type": "boolean"
        }
      },
      "required": [
        "ok"
      ],
      "type": "object"
    },
    "route": {}
  },
  "credentials.list": {
    "input": null,
    "meta": {},
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "credentials": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "hasPassword": {
                "type": "boolean"
              },
              "hasTotp": {
                "type": "boolean"
              },
              "name": {
                "type": "string"
              },
              "origins": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "personalities": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "policyValid": {
                "type": "boolean"
              },
              "unattended": {
                "type": "boolean"
              },
              "usernamePreview": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "origins",
              "personalities",
              "unattended",
              "usernamePreview",
              "hasPassword",
              "hasTotp",
              "policyValid"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "credentials"
      ],
      "type": "object"
    },
    "route": {}
  },
  "credentials.set": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "name": {
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "type": "string"
        },
        "origins": {
          "items": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array"
        },
        "password": {
          "maxLength": 8192,
          "minLength": 1,
          "type": "string"
        },
        "personalities": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "type": "array"
        },
        "totp": {
          "anyOf": [
            {
              "maxLength": 8192,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "unattended": {
          "type": "boolean"
        },
        "username": {
          "maxLength": 8192,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name",
        "origins",
        "personalities",
        "unattended"
      ],
      "type": "object"
    },
    "meta": {},
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "ok": {
          "const": true,
          "type": "boolean"
        }
      },
      "required": [
        "ok"
      ],
      "type": "object"
    },
    "route": {}
  }
}
