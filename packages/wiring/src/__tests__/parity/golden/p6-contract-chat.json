{
  "chat.abort": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "sessionId": {
          "type": "string"
        }
      },
      "required": [
        "sessionId"
      ],
      "type": "object"
    },
    "meta": {},
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "ok": {
          "const": true,
          "type": "boolean"
        }
      },
      "required": [
        "ok"
      ],
      "type": "object"
    },
    "route": {}
  },
  "chat.endIncognito": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "sessionId": {
          "type": "string"
        }
      },
      "required": [
        "sessionId"
      ],
      "type": "object"
    },
    "meta": {},
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "ok": {
          "const": true,
          "type": "boolean"
        },
        "scrubbed": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "ok",
        "scrubbed"
      ],
      "type": "object"
    },
    "route": {}
  },
  "chat.send": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "attachments": {
          "items": {
            "properties": {
              "data": {
                "type": "string"
              },
              "mimeType": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "image",
                  "file"
                ],
                "type": "string"
              }
            },
            "required": [
              "type",
              "data",
              "mimeType"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "clientId": {
          "minLength": 1,
          "type": "string"
        },
        "dryRun": {
          "type": "boolean"
        },
        "incognito": {
          "type": "boolean"
        },
        "origin": {
          "enum": [
            "text",
            "voice"
          ],
          "type": "string"
        },
        "personalityId": {
          "type": "string"
        },
        "sessionId": {
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "type": "string"
        },
        "userId": {
          "type": "string"
        }
      },
      "required": [
        "clientId",
        "text"
      ],
      "type": "object"
    },
    "meta": {},
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "sessionId": {
          "type": "string"
        },
        "turnId": {
          "type": "string"
        }
      },
      "required": [
        "sessionId",
        "turnId"
      ],
      "type": "object"
    },
    "route": {}
  },
  "chat.steer": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "sessionId": {
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "sessionId",
        "text"
      ],
      "type": "object"
    },
    "meta": {},
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "ok": {
          "type": "boolean"
        }
      },
      "required": [
        "ok"
      ],
      "type": "object"
    },
    "route": {}
  }
}
