{
  "admin.addMcpServer": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "authType": {
          "enum": [
            "none",
            "bearer",
            "oauth"
          ],
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "url",
        "authType"
      ],
      "type": "object"
    },
    "meta": {},
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "ok": {
          "const": true,
          "type": "boolean"
        }
      },
      "required": [
        "ok"
      ],
      "type": "object"
    },
    "route": {}
  },
  "admin.checkProvider": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "provider": {
          "type": "string"
        }
      },
      "required": [
        "provider"
      ],
      "type": "object"
    },
    "meta": {},
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "latencyMs": {
          "type": "number"
        },
        "ok": {
          "type": "boolean"
        }
      },
      "required": [
        "ok",
        "latencyMs"
      ],
      "type": "object"
    },
    "route": {}
  },
  "admin.getStatus": {
    "input": null,
    "meta": {},
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "channels": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "platform": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "connected",
                  "disconnected",
                  "error"
                ],
                "type": "string"
              },
              "webhookUrl": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "platform",
              "status"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "executionBackend": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "error": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "name": {
                  "const": "ssh",
                  "type": "string"
                },
                "resolved": {
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "resolved",
                "error"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "mcpServers": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "connected",
                  "disconnected",
                  "error"
                ],
                "type": "string"
              },
              "toolCount": {
                "type": "number"
              }
            },
            "required": [
              "name",
              "status"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "providers": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "hasKey": {
                "type": "boolean"
              },
              "healthy": {
                "type": "boolean"
              },
              "id": {
                "type": "string"
              },
              "latencyMs": {
                "type": "number"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "hasKey"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "channels",
        "providers",
        "mcpServers",
        "executionBackend"
      ],
      "type": "object"
    },
    "route": {}
  },
  "admin.removeMcpServer": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "meta": {},
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "ok": {
          "const": true,
          "type": "boolean"
        }
      },
      "required": [
        "ok"
      ],
      "type": "object"
    },
    "route": {}
  },
  "admin.rotateKey": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "key": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "key"
      ],
      "type": "object"
    },
    "meta": {},
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "ok": {
          "const": true,
          "type": "boolean"
        }
      },
      "required": [
        "ok"
      ],
      "type": "object"
    },
    "route": {}
  },
  "admin.testSend": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "channel": {
          "type": "string"
        }
      },
      "required": [
        "channel"
      ],
      "type": "object"
    },
    "meta": {},
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        }
      },
      "required": [
        "ok"
      ],
      "type": "object"
    },
    "route": {}
  }
}
