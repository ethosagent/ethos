              "type": "string"
            },
            "readonly": {
              "type": "boolean"
            },
            "source": {
              "enum": [
                "system",
                "user",
                "evolver",
                "personality"
              ],
              "type": "string"
            },
            "unavailableReason": {
              "anyOf": [
                {
                  "type": "string"
