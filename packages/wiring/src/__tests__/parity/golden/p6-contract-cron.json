        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "notifyInApp": {
          "type": "boolean"
        },
        "personalityId": {
          "minLength": 1,
          "type": "string"
        },
        "prompt": {
          "minLength": 1,
          "type": "string"
        },
        "schedule": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name",
        "schedule",
        "prompt",
        "personalityId"
      ],
      "type": "object"
    },
    "meta": {},
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "job": {
          "additionalProperties": false,
          "properties": {
            "activeHours": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "createdAt": {
              "type": "string"
            },
            "deliver": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "id": {
              "type": "string"
            },
            "lastRunAt": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "missedRunPolicy": {
              "enum": [
                "run-once",
                "skip"
              ],
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "nextRunAt": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "personalityId": {
              "type": "string"
            },
            "prompt": {
              "type": "string"
            },
            "schedule": {
              "type": "string"
            },
            "source": {
              "default": "user",
              "enum": [
                "system",
                "user"
              ],
              "type": "string"
            },
            "status": {
              "enum": [
                "active",
                "paused",
                "done"
              ],
              "type": "string"
            },
            "systemTask": {
              "anyOf": [
