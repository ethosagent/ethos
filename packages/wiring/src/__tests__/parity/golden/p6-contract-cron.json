            {
              "properties": {
                "botKey": {
                  "minLength": 1,
                  "type": "string"
                },
                "chatId": {
                  "minLength": 1,
                  "type": "string"
                },
                "kind": {
                  "const": "channel",
                  "type": "string"
                },
                "platform": {
                  "minLength": 1,
                  "type": "string"
