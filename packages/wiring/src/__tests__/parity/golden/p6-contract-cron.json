          "required": [
            "id",
            "name",
            "schedule",
            "prompt",
            "personalityId",
            "deliver",
            "status",
            "missedRunPolicy",
            "source",
            "lastRunAt",
            "nextRunAt",
            "createdAt"
          ],
          "type": "object"
        }
      },
      "required": [
        "job"
      ],
      "type": "object"
    },
    "route": {}
  },
