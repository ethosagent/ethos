# Azure OpenAI credentials
# Copy this file to .env and fill in your real values.
# The .env file is gitignored — never commit it.

# Where ethos stores its state (config, secrets, sessions, logs).
# Default: unset — the Docker named volume `ethos-data`. Keep it that way on
# Docker Desktop (macOS/Windows): a host path there is a virtiofs/gRPC-FUSE or
# 9p mount, where SQLite locking is unsafe and the databases can corrupt.
# To use a host directory anyway (native Linux Docker), set a path, absolute or
# relative to the docker/ folder:
#   ETHOS_DATA_DIR=../ethos-data

# The agent's working directory on YOUR machine — files it writes to cwd land
# here and persist across restarts. Same path rules as ETHOS_DATA_DIR.
# Default: ../ethos-workspace
ETHOS_WORKSPACE_DIR=../ethos-workspace

AZURE_API_KEY=your-azure-openai-api-key-here
AZURE_ENDPOINT=https://your-resource.openai.azure.com
AZURE_MODEL=gpt-4o
AZURE_API_VERSION=2024-12-01-preview

# OpenRouter credentials (alternative to Azure)
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openai/gpt-4o
TELEGRAM_BOT_TOKEN=token_bot_token_here

# Your Telegram user ID (get it from @userinfobot on Telegram) — required when TELEGRAM_BOT_TOKEN is set
# TELEGRAM_OWNER_ID=123456789

# Personality to use (default: researcher). Run 'ethos personality list' to see all options.
# ETHOS_PERSONALITY=researcher
