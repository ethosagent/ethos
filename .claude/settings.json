{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/guard-architecture.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "out=$(python3 .agents/skills/session-audit/scripts/parse-transcript 2>/dev/null | python3 .agents/skills/session-audit/scripts/format-output 2>/dev/null); [ -z \"$out\" ] && echo '{\"suppressOutput\":true}' || echo \"$out\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
