# JS mirror files — compiled from TS source, not committed
# (standalone .js files with no .ts counterpart are still tracked)
src/**/*.js
src/**/*.js.map
# The root-anchored patterns above never matched these nested src/ dirs, so stale mirrors got committed
apps/tui/src/**/*.js
apps/tui/src/**/*.js.map
packages/ui-components/src/**/*.js
packages/ui-components/src/**/*.js.map
.mcp.json

# Adapter state accidentally written to the process CWD. The Telegram, Discord
# and WhatsApp adapters fall back to a RELATIVE state directory
# (`config.discordDir ?? 'discord'` and friends) and FsStorage is unrooted, so a
# construction site — or a test — that does not qualify the path writes here
# instead of under ~/.ethos. Root-anchored (leading `/`) so they match only the
# repo root and cannot mask extensions/platform-discord/ or any real source path.
/discord/
/telegram/
/whatsapp/
