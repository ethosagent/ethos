{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!dist/",
      "!node_modules/",
      "!.turbo/",
      "!**/*.svg",
      "!plugins/*/src/data/vocabulary-baseline.json",
      "!plugins/*/test/fixtures/**/*.html",
      "!plugins/*/test/fixtures/**/*.css",
      "!plugins/*/test/fixtures/**/*.xml",
      "!plugins/*/test/fixtures/**/*.txt",
      "!plugins/*/test/fixtures/**/*.csv",
      "!plugins/*/test/fixtures/**/*.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  }
}
